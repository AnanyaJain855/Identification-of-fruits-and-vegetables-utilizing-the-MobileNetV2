//Result visualization
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Food Analysis Results - Smart Refrigerator</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/css/bootstrap.min.css" rel="stylesheet"/>
  <style>
    body {
      background-color: #e8f5e9;
      background-image: url('/static/fruits1.png');
      background-size: cover;
      background-position: center;
      background-attachment: fixed;
      font-family: 'Arial', sans-serif;
      min-height: 100vh;
    }
    .container {
      background-color: rgba(255, 255, 255, 0.95);
      border-radius: 15px;
      padding: 30px;
      margin-top: 50px;
      box-shadow: 0 0 20px rgba(0, 0, 0, 0.2);
      max-width: 900px;
    }
    .header {
      display: flex;
      align-items: center;
      margin-bottom: 30px;
    }
    .logo {
      max-width: 80px;
      margin-right: 20px;
      display: block;
    }
    h1 {
      color: #27ae60;
      font-weight: bold;
      margin-bottom: 0;
      flex-grow: 1;
    }
    .result-card {
      border-radius: 10px;
      overflow: hidden;
      box-shadow: 0 0 15px rgba(0, 0, 0, 0.1);
    }
    .result-image {
      width: 100%;
      height: auto;
      object-fit: cover;
      max-height: 300px;
      border-bottom: 1px solid #eee;
    }
    .result-details {
      padding: 20px;
    }
    .result-item {
      margin-bottom: 15px;
      padding-bottom: 15px;
      border-bottom: 1px solid #eee;
    }
    .result-label {
      font-weight: bold;
      color: #2c3e50;
    }
    .badge {
      font-size: 14px;
      padding: 8px 12px;
    }
    .btn-back {
      background-color: #27ae60;
      border-color: #27ae60;
      margin-top: 20px;
    }
    .freshness-healthy { color: #27ae60; }
    .freshness-rotten { color: #c0392b; }
    .progress {
      height: 10px;
      margin-top: 5px;
    }
    .medical-properties {
      background-color: #f3fff4;
      border-radius: 8px;
      padding: 15px;
      margin-top: 20px;
    }
    .medical-property {
      margin-bottom: 8px;
      padding-left: 20px;
      position: relative;
    }
    .medical-property:before {
      content: "•";
      position: absolute;
      left: 5px;
      color: #27ae60;
    }
    .order-alert {
      background-color: #fff3cd;
      color: #856404;
      border-radius: 8px;
      padding: 10px;
      margin-top: 10px;
      border-left: 4px solid #ffc107;
    }
  </style>
</head>
<body>
  <div class="container">
    <div class="header">
      <img src="/static/logo.png" alt="Logo" class="logo" />
      <h1>Food Analysis Results</h1>
    </div>

    <div class="row">
      <div class="col-md-6 mb-4">
        <div class="result-card">
          {% if image_path %}
            <img src="{{ url_for('static', filename=image_path) }}" alt="Uploaded Image" class="result-image"
                 onerror="this.onerror=null; this.src='/static/images/placeholder-fruit.jpg';" />
          {% else %}
            <img src="/static/images/placeholder-fruit.jpg" alt="Placeholder" class="result-image" />
          {% endif %}
        </div>
      </div>

      <div class="col-md-6 mb-4">
        <div class="result-card">
          <div class="result-details">
            <!-- Food Type -->
            <div class="result-item">
              <div class="result-label">Food Type:</div>
              <div class="fs-3 text-capitalize">{{ food }}</div>
              <div class="small text-muted">Confidence: {{ food_confidence }}%</div>
              <div class="progress">
                <div class="progress-bar bg-success" style="width: {{ food_confidence }}%"></div>
              </div>
            </div>

            <!-- Freshness -->
            <div class="result-item">
              <div class="result-label">Freshness:</div>
              <div class="fs-4 {% if rottenness == 'Healthy' %}freshness-healthy{% else %}freshness-rotten{% endif %}">
                {{ rottenness }}
              </div>
              <div class="small text-muted">Confidence: {{ rot_confidence }}%</div>
              <div class="progress">
                <div class="progress-bar {% if rottenness == 'Healthy' %}bg-success{% else %}bg-danger{% endif %}"
                     style="width: {{ rot_confidence }}%"></div>
              </div>
            </div>

            <!-- Ripeness -->
            {% if ripeness is defined and ripeness != "N/A" %}
            <div class="result-item">
              <div class="result-label">Ripeness:</div>
              <div class="fs-5 text-capitalize">
                {% if ripeness == 'Ripe' %}
                  <span class="text-success">{{ ripeness }}</span>
                {% elif ripeness == 'Unripe' %}
                  <span class="text-warning">{{ ripeness }}</span>
                {% else %}
                  {{ ripeness }}
                {% endif %}
              </div>
              <div class="small text-muted">Confidence: {{ ripeness_confidence }}%</div>
              <div class="progress">
                <div class="progress-bar bg-info" style="width: {{ ripeness_confidence }}%"></div>
              </div>
            </div>
            {% endif %}

            <!-- Object Count -->
            {% if object_count %}
            <div class="result-item">
              <div class="result-label">Detected Items:</div>
              <ul class="list-unstyled">
                {% for name, count in object_count.items() %}
                  <li>{{ name.capitalize() }}: <strong>{{ count }}</strong></li>
                  {% if count < 2 %}
                    <div class="order-alert">⚠ Order more {{ name.capitalize() }}!</div>
                  {% endif %}
                {% endfor %}
              </ul>
            </div>
            {% endif %}

            <!-- Medical Properties -->
            <div class="result-item">
              <div class="result-label">Medical Properties:</div>
              <div class="medical-properties">
                {% if food.lower() == 'apple' %}
                  <div class="medical-property">Rich in antioxidants that fight free radicals.</div>
                  <div class="medical-property">Helps reduce risk of heart disease and diabetes.</div>
                {% elif food.lower() == 'banana' %}
                  <div class="medical-property">High in potassium and fiber for heart health.</div>
                  <div class="medical-property">Supports digestion and muscle recovery.</div>
                {% elif food.lower() == 'grapes' %}
                  <div class="medical-property">Rich in resveratrol and flavonoids for heart protection.</div>
                  <div class="medical-property">May support brain health and immunity.</div>
                {% elif food.lower() == 'orange' %}
                  <div class="medical-property">Excellent source of vitamin C for immunity.</div>
                  <div class="medical-property">Contains flavonoids that reduce inflammation.</div>
                {% elif food.lower() == 'pineapple' %}
                  <div class="medical-property">Contains bromelain, a powerful anti-inflammatory.</div>
                  <div class="medical-property">Supports digestion and tissue healing.</div>
                {% elif food.lower() == 'watermelon' %}
                  <div class="medical-property">High water content helps with hydration.</div>
                  <div class="medical-property">Contains lycopene for heart and skin protection.</div>
                {% elif food.lower() == 'tomato' %}
                  <div class="medical-property">Packed with lycopene and potassium.</div>
                  <div class="medical-property">Supports heart, skin, and prostate health.</div>
                {% elif food.lower() == 'potato' %}
                  <div class="medical-property">Good source of vitamin C and potassium.</div>
                  <div class="medical-property">Provides energy and supports nerve health.</div>
                {% elif food.lower() == 'beetroot' %}
                  <div class="medical-property">Rich in nitrates that help lower blood pressure.</div>
                  <div class="medical-property">Contains betalains with anti-inflammatory properties.</div>
                {% elif food.lower() == 'bell pepper' or food.lower() == 'capsicum' %}
                  <div class="medical-property">Extremely high in vitamin C for immune support.</div>
                  <div class="medical-property">Contains carotenoids for eye health.</div>
                {% elif food.lower() == 'cabbage' %}
                  <div class="medical-property">Rich in vitamin K and anthocyanins for heart health.</div>
                  <div class="medical-property">Contains sulforaphane with anticancer properties.</div>
                {% elif food.lower() == 'carrot' %}
                  <div class="medical-property">High in beta-carotene supporting eye health.</div>
                  <div class="medical-property">Contains antioxidants that may reduce cancer risk.</div>
                {% elif food.lower() == 'cauliflower' %}
                  <div class="medical-property">Rich in choline for brain health and development.</div>
                  <div class="medical-property">Contains glucosinolates with anticancer properties.</div>
                {% elif food.lower() == 'chilli pepper' or food.lower() == 'jalapeno' %}
                  <div class="medical-property">Contains capsaicin that may boost metabolism.</div>
                  <div class="medical-property">Rich in vitamin C and helps with pain relief.</div>
                {% elif food.lower() == 'corn' or food.lower() == 'sweetcorn' %}
                  <div class="medical-property">Contains lutein and zeaxanthin for eye health.</div>
                  <div class="medical-property">Rich in fiber that supports digestive health.</div>
                {% elif food.lower() == 'cucumber' %}
                  <div class="medical-property">High water content helps with hydration.</div>
                  <div class="medical-property">Contains antioxidants that reduce inflammation.</div>
                {% elif food.lower() == 'eggplant' %}
                  <div class="medical-property">Rich in nasunin that protects brain cell membranes.</div>
                  <div class="medical-property">Contains fiber and potassium for heart health.</div>
                {% elif food.lower() == 'garlic' %}
                  <div class="medical-property">Contains allicin with antimicrobial properties.</div>
                  <div class="medical-property">May help reduce cholesterol and blood pressure.</div>
                {% elif food.lower() == 'ginger' %}
                  <div class="medical-property">Powerful anti-inflammatory and digestive aid.</div>
                  <div class="medical-property">Helps reduce nausea and muscle pain.</div>
                {% elif food.lower() == 'lettuce' %}
                  <div class="medical-property">Contains vitamin K for bone health.</div>
                  <div class="medical-property">Rich in folate essential for DNA synthesis.</div>
                {% elif food.lower() == 'onion' %}
                  <div class="medical-property">Rich in quercetin with anti-inflammatory effects.</div>
                  <div class="medical-property">May help regulate blood sugar levels.</div>
                {% elif food.lower() == 'paprika' %}
                  <div class="medical-property">High in vitamin A for immune function.</div>
                  <div class="medical-property">Contains capsanthin with antioxidant properties.</div>
                {% elif food.lower() == 'peas' %}
                  <div class="medical-property">Excellent source of plant-based protein and fiber.</div>
                  <div class="medical-property">Rich in vitamins A, K, and folate.</div>
                {% elif food.lower() == 'radish' %}
                  <div class="medical-property">Contains isothiocyanates that may fight cancer cells.</div>
                  <div class="medical-property">Supports liver function and digestion.</div>
                {% elif food.lower() == 'soy beans' %}
                  <div class="medical-property">Contain isoflavones that may reduce heart disease risk.</div>
                  <div class="medical-property">Excellent source of plant protein and omega-3.</div>
                {% elif food.lower() == 'spinach' %}
                  <div class="medical-property">Rich in iron and magnesium for energy production.</div>
                  <div class="medical-property">Contains lutein for eye health and nitrates for blood pressure.</div>
                {% elif food.lower() == 'turnip' %}
                  <div class="medical-property">High in fiber and vitamin C for immunity.</div>
                  <div class="medical-property">Contains glucosinolates with cancer-fighting properties.</div>
                {% else %}
                  <p>No specific medical facts found for this food.</p>
                {% endif %}
              </div>
            </div>

            <!-- Back Button -->
            <div class="text-center">
              <a href="/" class="btn btn-primary btn-back">Analyze Another Item</a>
            </div>

          </div>
        </div>
      </div>
    </div>
  </div>

  <script>
    document.addEventListener('DOMContentLoaded', function () {
      document.querySelectorAll('.fs-4, .badge').forEach(el => {
        const text = el.textContent.trim().toLowerCase();
        if (text.includes('healthy') && text !== 'healthy') el.textContent = 'Healthy';
        else if (text.includes('rotten') && text !== 'rotten') el.textContent = 'Rotten';
      });
    });
  </script>
</body>
</html>
